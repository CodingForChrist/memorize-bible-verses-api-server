{
  "name": "memorize-bible-verses-api-server",
  "version": "1.17.0",
  "type": "module",
  "private": true,
  "description": "Node.js Express server that wraps API.Bible",
  "main": "src/server.ts",
  "scripts": {
    "build": "tsc",
    "check-node-version": "node src/tasks/check-node-version.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "test": "node --test --experimental-test-module-mocks",
    "coverage": "npm run test -- --experimental-test-coverage",
    "dev": "npm start",
    "start": "npm run check-node-version && node --watch src/server.ts | pino-pretty",
    "start-production": "node src/server.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@isaacs/ttlcache": "^2.1.5",
    "cors": "^2.8.6",
    "dayjs": "^1.11.23",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@flydotio/dockerfile": "^0.7.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.3",
    "@types/semver": "^7.8.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.10.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "semver": "^7.8.5",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
